# Environment variables read by api/*.js. Copy to .env for local dev
# (node --env-file=.env scripts/dev-server.js) and set them in Vercel > Settings > Environment Variables.

# intervals.icu (sport page)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Cinema page: read a saved Letterboxd RSS feed instead of fetching it (local dev only)
# LETTERBOXD_RSS_FILE=data/cinema.xml

# TMDB read access token (cinema page: director and main cast, api/credits.js)
TMDB_READ_TOKEN=
